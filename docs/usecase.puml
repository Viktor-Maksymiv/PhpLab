@startuml
left to right direction

actor "Глядач" as Customer
actor "Касир" as Cashier
actor "Адміністратор" as Admin

rectangle "Електронна система продажу квитків до кінотеатру" {
  usecase "Переглянути афішу" as UC1
  usecase "Придбати квиток" as UC2
  usecase "Скасувати замовлення" as UC3
  usecase "Переглянути мої замовлення" as UC4
  usecase "Продати квиток на касі" as UC5
  usecase "Перевірити квиток" as UC6
  usecase "Оформити повернення квитка" as UC7
  usecase "Керувати фільмами" as UC8
  usecase "Додати сеанс до розкладу" as UC9
  usecase "Переглянути звіт про продажі" as UC10
  usecase "Авторизуватися" as UC11
  usecase "Обрати місця" as UC12
  usecase "Оплатити замовлення" as UC13
  usecase "Застосувати промокод" as UC14
  usecase "Надіслати квиток на email" as UC15
  usecase "Повернути кошти" as UC16
  usecase "Оплатити карткою онлайн" as UC17
  usecase "Оплатити готівкою на касі" as UC18
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4

Cashier --> UC5
Cashier --> UC6
Cashier --> UC7

Admin --> UC8
Admin --> UC9
Admin --> UC10

Admin --|> Cashier

UC2 ..> UC11 : <<include>>
UC2 ..> UC12 : <<include>>
UC2 ..> UC13 : <<include>>
UC3 ..> UC11 : <<include>>
UC4 ..> UC11 : <<include>>
UC5 ..> UC12 : <<include>>
UC5 ..> UC13 : <<include>>
UC8 ..> UC11 : <<include>>

UC14 ..> UC2 : <<extend>>
UC15 ..> UC13 : <<extend>>
UC16 ..> UC3 : <<extend>>

UC17 --|> UC13
UC18 --|> UC13
@enduml
